<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppLibertadoresHAS.Views.Jogadores.ListagemJogadorView"
             Title="ListagemJogadorView">
    <ScrollView>
        <VerticalStackLayout Padding="10,0,0,0">

            <CollectionView
            x:Name="listView"
            ItemsSource="{Binding Jogadores}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                        Margin="5"
                        Padding="10"
                        BackgroundColor="LightGray">
                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                Grid.Column="0"
                                FontSize="18"
                                FontAttributes="Bold"
                                Text="{Binding Nome}"
                                VerticalOptions="Center" />

                                <Label
                                Grid.Column="1"
                                FontSize="20"
                                FontAttributes="Bold"
                                Text="{Binding NumeroCamisa}"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>